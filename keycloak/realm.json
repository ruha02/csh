{
  "id": "csh",
  "realm": "csh",
  "displayName": "CSH Realm",
  "loginTheme": "fsp",
  "enabled": true,
  "clients": [
    {
      "clientId": "web",
      "name": "Web Client",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://web.localhost/*",
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://csh.goodgenius.ru/*"
      ],
      "webOrigins": [
        "http://web.localhost",
        "http://localhost:5173",
        "http://localhost:3000",
        "http://csh.goodgenius.ru"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "api",
      "name": "API Client",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "bearerOnly": false,
      "secret": "api-secret-key",
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admins",
        "description": "Администраторы"
      },
      {
        "name": "employers",
        "description": "Работодатели"
      },
      {
        "name": "candidats",
        "description": "Кандидаты"
      }
    ]
  },
  "users": [
